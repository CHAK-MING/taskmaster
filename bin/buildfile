import foundation = ../src/lib{dagforge-foundation}
import dagforge = ../src/lib{dagforge}

./: exe{dagforge}                  \
    exe{modules-foundation-smoke} \
    exe{core-unit-tests}          \
    exe{unit-runtime-tests}       \
    exe{unit-api-tests}           \
    exe{all-unit-tests}           \
    exe{bench-core}

exe{dagforge}: ../src/cxx{main} $dagforge $foundation
{
  cxx.poptions += "-DBOOST_ASIO_HAS_IO_URING=0" \
                  "-DDAGFORGE_USE_MIMALLOC=0"
}

exe{modules-foundation-smoke}: ../tests/cxx{modules-foundation-smoke} $foundation

core_tests = ../tests/cxx{test_main runtime_test workflow_test coroutine_test \
    shard_test shard_affinity_test timing_wheel_test config_test \
    http_client_test http_server_test http_parser_test router_test \
    process_management_test io_bridge_test metrics_registry_test \
    metrics_exporter_test daemon_test log_test docker_client_test \
    docker_executor_test api_test}

exe{core-unit-tests}: $core_tests $dagforge $foundation
{
  test = true
  cxx.libs += -lgtest -pthread
}

exe{unit-runtime-tests}: $core_tests $dagforge $foundation
{
  test = true
  cxx.libs += -lgtest -pthread
}

exe{unit-api-tests}: ../tests/cxx{test_main api_test workflow_test} \
  $dagforge $foundation
{
  test = true
  cxx.libs += -lgtest -pthread
}

exe{all-unit-tests}: $core_tests $dagforge $foundation
{
  test = true
  cxx.libs += -lgtest -pthread
}

exe{bench-core}: ../tests/cxx{bench_memory_arena bench_runtime \
    bench_lua_executor} $dagforge $foundation
{
  cxx.libs += -lbenchmark_main -lbenchmark -pthread
}

../tests/cxx{bench_*}: cxx.poptions += -U__COUNTER__
