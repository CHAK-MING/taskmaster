# Frontend dependencies and build output remain ignored if an optional UI is
# introduced again.
/web-ui/node_modules/
/web-ui/dist/

# Local editor and assistant configuration.
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
/.codex/
/.claude/
/.mcp.json

# build2 and compiler-generated output.
/bin/*
!/bin/buildfile
/build/*
!/build/bootstrap.build
!/build/export.build
!/build/root.build
/build-*
/.bdep/
/.bpkg/
/.build2-configs/
/gcm.cache/
/.cache/
/.clangd-tools/
/compile_commands.json
/compile_commands.json.tmp
/dist/

# Local runtime data.
*.db
/workspaces/

# Python caches.
__pycache__/
/.ruff_cache/

# Generated benchmark results.
/bench_results/

docs/ai/*
AGENTS.md

openspce/